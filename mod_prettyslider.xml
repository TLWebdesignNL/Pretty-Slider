<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
    <name>MOD_PRETTYSLIDER</name>
    <creationDate>2026-10-10</creationDate>
    <author>Tom van der Laan</author>
    <authorEmail>info@tlwebdesign.nl</authorEmail>
    <authorUrl>https://tlwebdesign.nl</authorUrl>
    <copyright>TLWebdesign</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE</license>
    <version>1.0.0</version>
    <description>MOD_PRETTYSLIDER_XML_DESCRIPTION</description>
    <scriptfile>script.php</scriptfile>
    <namespace path="src">TLWeb\Module\Prettyslider</namespace>
    <files>
        <folder module="mod_prettyslider">services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
        <folder>language</folder>
    </files>
    <media folder="media" destination="mod_prettyslider">
        <folder>css</folder>
        <folder>js</folder>
        <filename>joomla.asset.json</filename>
        <filename>logo.svg</filename>
    </media>
    <config>
        <fields name="params" addruleprefix="TLWeb\Module\Prettyslider\Site\Rule">
            <fieldset name="basic">
                <field
                        name="logo"
                        type="note"
                        description="MOD_PRETTYSLIDER_FIELD_LOGO_DESC"
                />
                <field
                        name="ownerinfo"
                        type="note"
                        description="MOD_PRETTYSLIDER_FIELD_OWNERINFO_DESC"
                />
                <field
                        name="info"
                        type="note"
                        description="MOD_PRETTYSLIDER_FIELD_INFO_DESC"
                />
            </fieldset>
            <fieldset name="settings" label="MOD_PRETTYSLIDER_FIELDSET_SETTINGS_LABEL">
                <field
                        name="source"
                        type="radio"
                        default="articles"
                        label="MOD_PRETTYSLIDER_FIELD_SOURCE_LABEL"
                        description="MOD_PRETTYSLIDER_FIELD_SOURCE_DESC"
                        class="btn-group"
                        validate="options"
                >
                    <option value="articles">MOD_PRETTYSLIDER_FIELD_SOURCE_ARTICLES</option>
                    <option value="manual">MOD_PRETTYSLIDER_FIELD_SOURCE_MANUAL</option>
                </field>
                <field
                        name="slides"
                        type="subform"
                        label="MOD_PRETTYSLIDER_FIELD_SLIDES_LABEL"
                        description="MOD_PRETTYSLIDER_FIELD_SLIDES_DESC"
                        multiple="true"
                        min="0"
                        max="20"
                        showon="source:manual"
                >
                    <form>
                        <field
                                name="image"
                                type="media"
                                label="MOD_PRETTYSLIDER_FIELD_SLIDEIMAGE_LABEL"
                                required="true"
                        />
                        <field
                                name="alt"
                                type="text"
                                label="MOD_PRETTYSLIDER_FIELD_SLIDEALT_LABEL"
                                description="MOD_PRETTYSLIDER_FIELD_SLIDEALT_DESC"
                        />
                        <field
                                name="title"
                                type="text"
                                label="MOD_PRETTYSLIDER_FIELD_SLIDETITLE_LABEL"
                                description="MOD_PRETTYSLIDER_FIELD_SLIDETITLE_DESC"
                        />
                        <field
                                name="description"
                                type="textarea"
                                label="MOD_PRETTYSLIDER_FIELD_SLIDEDESC_LABEL"
                                description="MOD_PRETTYSLIDER_FIELD_SLIDEDESC_DESC"
                                rows="3"
                        />
                        <field
                                name="link"
                                type="url"
                                filter="url"
                                validate="slideurl"
                                message="MOD_PRETTYSLIDER_FIELD_SLIDELINK_INVALID"
                                relative="true"
                                label="MOD_PRETTYSLIDER_FIELD_SLIDELINK_LABEL"
                                description="MOD_PRETTYSLIDER_FIELD_SLIDELINK_DESC"
                        />
                        <field
                                name="buttontext"
                                type="text"
                                label="MOD_PRETTYSLIDER_FIELD_BUTTONTEXT_LABEL"
                                description="MOD_PRETTYSLIDER_FIELD_SLIDEBUTTONTEXT_DESC"
                        />
                        <field
                                name="buttonclass"
                                type="checkboxes"
                                default="btn,btn-primary"
                                label="MOD_PRETTYSLIDER_FIELD_BUTTONCLASS_LABEL"
                                description="MOD_PRETTYSLIDER_FIELD_BUTTONCLASS_DESC"
                                multiple="true"
                        >
                            <option value="btn">MOD_PRETTYSLIDER_BUTTONCLASS_BTN</option>
                            <option value="btn-primary">MOD_PRETTYSLIDER_BUTTONCLASS_BTNPRIMARY</option>
                            <option value="btn-secondary">MOD_PRETTYSLIDER_BUTTONCLASS_BTNSECONDARY</option>
                            <option value="btn-success">MOD_PRETTYSLIDER_BUTTONCLASS_BTNSUCCESS</option>
                            <option value="btn-danger">MOD_PRETTYSLIDER_BUTTONCLASS_BTNDANGER</option>
                            <option value="btn-warning">MOD_PRETTYSLIDER_BUTTONCLASS_BTNWARNING</option>
                            <option value="btn-info">MOD_PRETTYSLIDER_BUTTONCLASS_BTNINFO</option>
                            <option value="btn-light">MOD_PRETTYSLIDER_BUTTONCLASS_BTNLIGHT</option>
                            <option value="btn-dark">MOD_PRETTYSLIDER_BUTTONCLASS_BTNDARK</option>
                            <option value="btn-link">MOD_PRETTYSLIDER_BUTTONCLASS_BTNLINK</option>
                            <option value="btn-lg">MOD_PRETTYSLIDER_BUTTONCLASS_BTNLG</option>
                            <option value="btn-sm">MOD_PRETTYSLIDER_BUTTONCLASS_BTNSM</option>
                            <option value="w-100">MOD_PRETTYSLIDER_BUTTONCLASS_W100</option>
                            <option value="custom">MOD_PRETTYSLIDER_BUTTONCLASS_CUSTOMCLASS</option>
                        </field>
                        <field
                                name="custombuttonclass"
                                type="text"
                                label="MOD_PRETTYSLIDER_FIELD_CUSTOMBUTTONCLASS_LABEL"
                                description="MOD_PRETTYSLIDER_FIELD_CUSTOMBUTTONCLASS_DESC"
                                hint="btn btn-primary"
                                showon="buttonclass:custom"
                        />
                        <field
                                name="newwindow"
                                type="radio"
                                default="0"
                                layout="joomla.form.field.radio.switcher"
                                label="MOD_PRETTYSLIDER_FIELD_SLIDENEWWINDOW_LABEL"
                                filter="integer"
                                validate="options"
                        >
                            <option value="0">JNO</option>
                            <option value="1">JYES</option>
                        </field>
                    </form>
                </field>
                <field
                        name="maxslides"
                        showon="source:articles"
                        type="number"
                        label="MOD_PRETTYSLIDER_FIELD_MAXSLIDES_LABEL"
                        description="MOD_PRETTYSLIDER_FIELD_MAXSLIDES_DESC"
                        default="5"
                        min="1"
                        max="20"
                        step="1"
                        filter="integer"
                />
                <field
                        name="desclength"
                        showon="source:articles"
                        type="number"
                        label="MOD_PRETTYSLIDER_FIELD_DESCLENGTH_LABEL"
                        description="MOD_PRETTYSLIDER_FIELD_DESCLENGTH_DESC"
                        default="40"
                        min="1"
                        max="255"
                        step="1"
                        filter="integer"
                />
                <field
                        name="descsource"
                        showon="source:articles"
                        type="list"
                        label="MOD_PRETTYSLIDER_FIELD_DESCSOURCE_LABEL"
                        description="MOD_PRETTYSLIDER_FIELD_DESCSOURCE_DESC"
                        default="articletext"
                        validate="options"
                >
                    <option value="articletext">MOD_PRETTYSLIDER_FIELD_DESCSOURCE_ARTICLE</option>
                    <option value="imagealt">MOD_PRETTYSLIDER_FIELD_DESCSOURCE_IMAGEALT</option>
                    <option value="imagecaption">MOD_PRETTYSLIDER_FIELD_DESCSOURCE_IMAGECAPTION</option>
                </field>
                <field
                        name="imagepriority"
                        showon="source:articles"
                        type="radio"
                        default="intro"
                        label="MOD_PRETTYSLIDER_FIELD_IMAGEPRIORITY_LABEL"
                        description="MOD_PRETTYSLIDER_FIELD_IMAGEPRIORITY_DESC"
                        class="btn-group"
                        required="true"
                        validate="options"
                >
                    <option value="intro">MOD_PRETTYSLIDER_INTROIMAGE</option>
                    <option value="fulltext">MOD_PRETTYSLIDER_FULLTEXTIMAGE</option>
                </field>
                <field
                        name="articlebutton"
                        showon="source:articles"
                        type="radio"
                        default="0"
                        layout="joomla.form.field.radio.switcher"
                        label="MOD_PRETTYSLIDER_FIELD_ARTICLEBUTTON_LABEL"
                        description="MOD_PRETTYSLIDER_FIELD_ARTICLEBUTTON_DESC"
                        filter="integer"
                        validate="options"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                        name="articlebuttontext"
                        showon="source:articles[AND]articlebutton:1"
                        type="text"
                        label="MOD_PRETTYSLIDER_FIELD_BUTTONTEXT_LABEL"
                        description="MOD_PRETTYSLIDER_FIELD_ARTICLEBUTTONTEXT_DESC"
                        hint="MOD_PRETTYSLIDER_READ_MORE"
                />
                <field
                        name="articlebuttonclass"
                        showon="source:articles[AND]articlebutton:1"
                        type="checkboxes"
                        default="btn,btn-primary"
                        label="MOD_PRETTYSLIDER_FIELD_BUTTONCLASS_LABEL"
                        description="MOD_PRETTYSLIDER_FIELD_BUTTONCLASS_DESC"
                        multiple="true"
                >
                    <option value="btn">MOD_PRETTYSLIDER_BUTTONCLASS_BTN</option>
                    <option value="btn-primary">MOD_PRETTYSLIDER_BUTTONCLASS_BTNPRIMARY</option>
                    <option value="btn-secondary">MOD_PRETTYSLIDER_BUTTONCLASS_BTNSECONDARY</option>
                    <option value="btn-success">MOD_PRETTYSLIDER_BUTTONCLASS_BTNSUCCESS</option>
                    <option value="btn-danger">MOD_PRETTYSLIDER_BUTTONCLASS_BTNDANGER</option>
                    <option value="btn-warning">MOD_PRETTYSLIDER_BUTTONCLASS_BTNWARNING</option>
                    <option value="btn-info">MOD_PRETTYSLIDER_BUTTONCLASS_BTNINFO</option>
                    <option value="btn-light">MOD_PRETTYSLIDER_BUTTONCLASS_BTNLIGHT</option>
                    <option value="btn-dark">MOD_PRETTYSLIDER_BUTTONCLASS_BTNDARK</option>
                    <option value="btn-link">MOD_PRETTYSLIDER_BUTTONCLASS_BTNLINK</option>
                    <option value="btn-lg">MOD_PRETTYSLIDER_BUTTONCLASS_BTNLG</option>
                    <option value="btn-sm">MOD_PRETTYSLIDER_BUTTONCLASS_BTNSM</option>
                    <option value="w-100">MOD_PRETTYSLIDER_BUTTONCLASS_W100</option>
                    <option value="custom">MOD_PRETTYSLIDER_BUTTONCLASS_CUSTOMCLASS</option>
                </field>
                <field
                        name="articlecustombuttonclass"
                        type="text"
                        label="MOD_PRETTYSLIDER_FIELD_CUSTOMBUTTONCLASS_LABEL"
                        description="MOD_PRETTYSLIDER_FIELD_CUSTOMBUTTONCLASS_DESC"
                        hint="btn btn-primary"
                        showon="source:articles[AND]articlebutton:1[AND]articlebuttonclass:custom"
                />
                <field
                        name="titletag"
                        type="list"
                        label="MOD_PRETTYSLIDER_FIELD_TITLETAG_LABEL"
                        description="MOD_PRETTYSLIDER_FIELD_TITLETAG_DESC"
                        default="p"
                        validate="options"
                >
                    <option value="p">MOD_PRETTYSLIDER_FIELD_TITLETAG_PARAGRAPH</option>
                    <option value="h2">h2</option>
                    <option value="h3">h3</option>
                    <option value="h4">h4</option>
                    <option value="h5">h5</option>
                    <option value="h6">h6</option>
                </field>
                <field
                        name="maindivclass"
                        type="text"
                        label="MOD_PRETTYSLIDER_FIELD_MAINDIVCLASS_LABEL"
                        description="MOD_PRETTYSLIDER_FIELD_MAINDIVCLASS_DESC"
                />
                <field
                        name="titleclass"
                        type="text"
                        label="MOD_PRETTYSLIDER_FIELD_TITLECLASS_LABEL"
                        description="MOD_PRETTYSLIDER_FIELD_TITLECLASS_DESC"
                        default="h5"
                />
                <field
                        name="descriptionclass"
                        type="text"
                        label="MOD_PRETTYSLIDER_FIELD_DESCRIPTIONCLASS_LABEL"
                        description="MOD_PRETTYSLIDER_FIELD_DESCRIPTIONCLASS_DESC"
                />
                <field
                        name="hidedescmobile"
                        type="radio"
                        default="1"
                        layout="joomla.form.field.radio.switcher"
                        label="MOD_PRETTYSLIDER_FIELD_HIDEDESCMOBILE_LABEL"
                        description="MOD_PRETTYSLIDER_FIELD_HIDEDESCMOBILE_DESC"
                        filter="integer"
                        validate="options"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                        name="autoplay"
                        type="radio"
                        default="1"
                        layout="joomla.form.field.radio.switcher"
                        label="MOD_PRETTYSLIDER_FIELD_AUTOPLAY_LABEL"
                        description="MOD_PRETTYSLIDER_FIELD_AUTOPLAY_DESC"
                        required="true"
                        filter="integer"
                        validate="options"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                        name="interval"
                        type="number"
                        label="MOD_PRETTYSLIDER_FIELD_INTERVAL_LABEL"
                        description="MOD_PRETTYSLIDER_FIELD_INTERVAL_DESC"
                        default="5"
                        min="2"
                        max="60"
                        step="1"
                        filter="integer"
                        showon="autoplay:1"
                />
                <field
                        name="pauseonhover"
                        type="radio"
                        default="1"
                        layout="joomla.form.field.radio.switcher"
                        label="MOD_PRETTYSLIDER_FIELD_PAUSEONHOVER_LABEL"
                        description="MOD_PRETTYSLIDER_FIELD_PAUSEONHOVER_DESC"
                        filter="integer"
                        validate="options"
                        showon="autoplay:1"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                        name="pausebutton"
                        type="radio"
                        default="1"
                        layout="joomla.form.field.radio.switcher"
                        label="MOD_PRETTYSLIDER_FIELD_PAUSEBUTTON_LABEL"
                        description="MOD_PRETTYSLIDER_FIELD_PAUSEBUTTON_DESC"
                        filter="integer"
                        validate="options"
                        showon="autoplay:1"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                        name="progress"
                        type="radio"
                        default="1"
                        layout="joomla.form.field.radio.switcher"
                        label="MOD_PRETTYSLIDER_FIELD_PROGRESS_LABEL"
                        description="MOD_PRETTYSLIDER_FIELD_PROGRESS_DESC"
                        filter="integer"
                        validate="options"
                        showon="autoplay:1"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                        name="indicators"
                        type="radio"
                        default="1"
                        layout="joomla.form.field.radio.switcher"
                        label="MOD_PRETTYSLIDER_FIELD_INDICATORS_LABEL"
                        description="MOD_PRETTYSLIDER_FIELD_INDICATORS_DESC"
                        filter="integer"
                        validate="options"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                        name="catid"
                        showon="source:articles"
                        type="category"
                        label="JCATEGORY"
                        extension="com_content"
                        multiple="true"
                        layout="joomla.form.field.list-fancy-select"
                        filter="intarray"
                        class="multipleCategories"
                />
                <field
                        name="article_ordering"
                        showon="source:articles"
                        type="list"
                        label="MOD_PRETTYSLIDER_CATEGORY_FIELD_ARTICLEORDERING_LABEL"
                        default="a.title"
                        validate="options"
                >
                    <option value="a.ordering">MOD_PRETTYSLIDER_CATEGORY_OPTION_ORDERING_VALUE</option>
                    <option value="fp.ordering">MOD_PRETTYSLIDER_CATEGORY_OPTION_ORDERINGFEATURED_VALUE</option>
                    <option value="a.title">JGLOBAL_TITLE</option>
                    <option value="a.id">MOD_PRETTYSLIDER_CATEGORY_OPTION_ID_VALUE</option>
                    <option value="a.alias">JFIELD_ALIAS_LABEL</option>
                    <option value="a.created">MOD_PRETTYSLIDER_CATEGORY_OPTION_CREATED_VALUE</option>
                    <option value="modified">MOD_PRETTYSLIDER_CATEGORY_OPTION_MODIFIED_VALUE</option>
                    <option value="publish_up">MOD_PRETTYSLIDER_CATEGORY_OPTION_STARTPUBLISHING_VALUE</option>
                    <option value="a.publish_down">MOD_PRETTYSLIDER_CATEGORY_OPTION_FINISHPUBLISHING_VALUE</option>
                    <option value="random">MOD_PRETTYSLIDER_CATEGORY_OPTION_RANDOM_VALUE</option>
                </field>
                <field
                        name="article_ordering_direction"
                        type="list"
                        label="MOD_PRETTYSLIDER_CATEGORY_FIELD_ARTICLEORDERINGDIR_LABEL"
                        default="ASC"
                        validate="options"
                        showon="source:articles[AND]article_ordering!:random"
                >
                    <option value="ASC">MOD_PRETTYSLIDER_CATEGORY_OPTION_ASCENDING_VALUE</option>
                    <option value="DESC">MOD_PRETTYSLIDER_CATEGORY_OPTION_DESCENDING_VALUE</option>
                </field>
            </fieldset>
            <fieldset name="advanced">
                <field
                        name="layout"
                        type="modulelayout"
                        label="JFIELD_ALT_LAYOUT_LABEL"
                        class="form-select"
                        validate="moduleLayout"
                />

                <field
                        name="moduleclass_sfx"
                        type="textarea"
                        label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
                        rows="3"
                        validate="CssIdentifier"
                />

                <field
                        name="cache"
                        type="list"
                        label="COM_MODULES_FIELD_CACHING_LABEL"
                        default="1"
                        filter="integer"
                        validate="options"
                >
                    <option value="1">JGLOBAL_USE_GLOBAL</option>
                    <option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
                </field>
                <field
                        name="cache_time"
                        type="number"
                        label="COM_MODULES_FIELD_CACHE_TIME_LABEL"
                        default="900"
                        filter="integer"
                />
                <field
                        name="cachemode"
                        type="hidden"
                        default="static"
                >
                    <option value="static"></option>
                </field>
            </fieldset>

        </fields>
    </config>
    <updateservers>
        <server type="extension" priority="2" name="Pretty Slider Updates">
            https://raw.githubusercontent.com/TLWebdesignNL/Pretty-Slider/main/updates.xml
        </server>
    </updateservers>
    <changelogurl>https://raw.githubusercontent.com/TLWebdesignNL/Pretty-Slider/main/changelog.xml</changelogurl>
</extension>
